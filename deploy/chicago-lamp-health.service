# The collector's health check, started by chicago-lamp-health.timer.
# deploy/README.md says how to install it.

[Unit]
Description=Chicago LAMP health check
Documentation=file:/opt/chicago-lamp/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=chicago-lamp
Group=chicago-lamp
ExecStart=/opt/chicago-lamp/.venv/bin/lamp-collector health
EnvironmentFile=/etc/chicago-lamp/collector.env

# The collector's own folder, which nobody else can write, so no stray .env
# can override the settings. The check only reads it.
WorkingDirectory=/var/lib/chicago-lamp
UMask=0077
# A run takes a second or two. Anything near this means the ping URL is not
# answering.
TimeoutStartSec=60

# The check reads the buffer and makes one outgoing HTTPS call.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
