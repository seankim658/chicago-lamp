# Copy this file to .env and fill in every value. Never commit .env.

# CTA keys. CTA issues them separately, so see the README for where to get each.
# Bus Tracker calls use the Bus Tracker key.
CTA_BUS_KEY=
# Train Tracker calls use the Train Tracker key.
CTA_TRAIN_KEY=
# Optional. GTFS-Realtime feeds are skipped while it is empty.
CTA_GTFSRT_KEY=

# Folder on the collector's host that holds responses until they are uploaded.
LAMP_BUFFER_DIR=./buffer

# S3-compatible object storage. For Cloudflare R2 the endpoint is
# https://<account id>.r2.cloudflarestorage.com and the region is auto.
LAMP_S3_ENDPOINT_URL=
LAMP_PRIVATE_BUCKET=
LAMP_PUBLIC_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
