# The collector's settings on a server. Copy to /etc/chicago-lamp/collector.env,
# owned by root with mode 600, and fill in the keys. Never commit the copy.

# CTA keys. The README says where to get each.
CTA_BUS_KEY=
CTA_TRAIN_KEY=
# Optional. GTFS-Realtime feeds are skipped while it is empty.
CTA_GTFSRT_KEY=

# Where responses wait until they are uploaded. The service owns this folder.
LAMP_BUFFER_DIR=/var/lib/chicago-lamp/buffer
