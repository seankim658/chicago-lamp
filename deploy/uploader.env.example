# The uploader's settings on a server. Copy to /etc/chicago-lamp/uploader.env,
# owned by root with mode 600, and fill in the keys. Never commit the copy.

# The collector's buffer, the same folder as in collector.env.
LAMP_BUFFER_DIR=/var/lib/chicago-lamp/buffer

# The private bucket. For Cloudflare R2 the endpoint is
# https://<account id>.r2.cloudflarestorage.com and the region is auto.
LAMP_S3_ENDPOINT_URL=
LAMP_PRIVATE_BUCKET=
AWS_DEFAULT_REGION=auto

# An R2 API token with Object Read & Write on the private bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
